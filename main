from fastapi import Depends, FastAPI, HTTPException
from pydantic import BaseModel, Field, field_validator
from typing import Dict, List

from database import models, crud
from database.db import SessionLocal, engine
from sqlalchemy.orm import Session
from database import schemas

models.Base.metadata.create_all(bind=engine)
app = FastAPI()


def get_db():
    db = SessionLocal()
    try:
        yield db
    except:
        db.close()
# Уявна база даних у вигляді словника
library: Dict[str, List[dict]] = {}

class Book(BaseModel):
    title: str = Field(..., min_length=1, max_length=100)
    author_name: str = Field(..., min_length=3, max_length=30)
    pages: int = Field(..., gt=10)

    @field_validator("title")
    @classmethod
    def title_not_blank(cls, v):
        if not v.strip():
            raise ValueError("Назва книги не може бути порожньою")
        return v


@app.get("/authors")
def get_all_authors(db:Session = Depends(get_db)):
    return crud.get_all_authors(db)

@app.post("/author/create")
def create_author(new_author:schemas.AuthorCreate,db:Session = Depends(get_db)):
    return crud.create_author(db, new_author)


@app.post("/books")
def create_book(book: Book):
    author_books = library.setdefault(book.author_name, [])
    for existing_book in author_books:
        if existing_book["title"].lower() == book.title.lower():
            raise HTTPException(status_code=400, detail="Книга вже існує")
    author_books.append(book.dict())
    return {"message": "Книгу додано", "book": book}

@app.get("/books")
def list_all_books():
    return {"library": library}

@app.get("/books/{author_name}")
def get_books_by_author(author_name: str):
    if author_name not in library:
        raise HTTPException(status_code=404, detail="Автор не знайдений")
    return {"author": author_name, "books": library[author_name]}

@app.put("/books")
def update_book(book: Book):
    if book.author_name not in library:
        raise HTTPException(status_code=404, detail="Автор не знайдений")

    for i, existing_book in enumerate(library[book.author_name]):
        if existing_book["title"].lower() == book.title.lower():
            library[book.author_name][i] = book.dict()
            return {"message": "Книгу оновлено", "book": book}

    raise HTTPException(status_code=404, detail="Книга не знайдена")

@app.delete("/books")
def delete_book(title: str, author_name: str):
    if author_name not in library:
        raise HTTPException(status_code=404, detail="Автор не знайдений")

    for i, existing_book in enumerate(library[author_name]):
        if existing_book["title"].lower() == title.lower():
            library[author_name].pop(i)
            if not library[author_name]:
                del library[author_name]
            return {"message": "Книгу видалено"}

    raise HTTPException(status_code=404, detail="Книга не знайдена")
     
